# Dot Family environment variables. Copy this file to .env.local and fill in what you need.
# Every variable is optional: without it the site keeps working and shows a calm
# "not configured" state for that feature. On Vercel, add them under
# Project > Settings > Environment Variables, then redeploy.

# Optional, server only. Private Robinhood Chain RPC for reads (balances, launch dry runs, receipts).
# Format: https://... endpoint URL (e.g. from your Alchemy dashboard, Robinhood Chain mainnet app). Falls back to the public RPC.
ROBINHOOD_RPC_URL=

# Optional, server only. Pinata JWT with pinFileToIPFS permission; enables custom picture upload on /create.
# Format: a long token that starts with eyJ. Get it at app.pinata.cloud > API Keys. Without it, launches use the character art.
PINATA_JWT=

# Optional, server only. IPFS gateway used for uploaded picture links (stored on chain, max 512 bytes).
# Format: https://<name>.mypinata.cloud/ipfs/ (your Pinata dedicated gateway). Default: https://ipfs.io/ipfs/
PINATA_GATEWAY=

# Optional, browser. WalletConnect project id; enables the WalletConnect option in the connect dialog.
# Format: 32 hex characters. Get it at cloud.reown.com > your project. Without it the option shows "Not configured".
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional, server only. OpenRouter API key; enables "Ask a dot" on /chat.
# Format: starts with sk-or-v1-. Get it at openrouter.ai/keys. Paid usage; keep it secret.
OPENROUTER_API_KEY=

# Optional, server only. Model used by "Ask a dot". Any OpenRouter model id.
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
